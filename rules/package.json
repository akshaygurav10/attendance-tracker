{
  "name": "attendance-tracker-rules",
  "version": "1.0.0",
  "private": true,
  "description": "Build and test tooling for database.rules.json (not used by the static app at runtime)",
  "scripts": {
    "build": "node build-rules.js",
    "test:build": "node --test build-rules.test.js",
    "test:rules": "firebase emulators:exec --only database --project demo-attendance-rules \"node --test database.rules.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.3.0",
    "firebase-tools": "15.36.0"
  }
}
